# Copy to .env and fill in. Never commit .env.
# Hashing index (no keys): export EMBEDDING_PROVIDER=hashing

# === Embedding model (for building the vector index) ===
# openai_compatible | huggingface | hashing
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_BATCH_SIZE=64

# === Assistant LLM (the model being benchmarked) ===
AGENT_LLM_MODEL=Qwen/Qwen3-32B
AGENT_LLM_BASE_URL=https://api.openai.com/v1
AGENT_LLM_API_KEY=your-llm-api-key
AGENT_LLM_TEMPERATURE=0
AGENT_MAX_TOOL_ROUNDS=10

# === Customer simulation LLM ===
# Uses the same AGENT_LLM_* by default. Override for a separate model:
# CUSTOMER_LLM_MODEL=gpt-4.1
# CUSTOMER_LLM_BASE_URL=https://api.openai.com/v1
# CUSTOMER_LLM_API_KEY=your-customer-api-key

# === Judge LLM (for scoring conversations) ===
JUDGE_MODEL=gpt-4.1
JUDGE_BASE_URL=https://api.openai.com/v1
JUDGE_API_KEY=your-judge-api-key

# === Paths (defaults are usually fine) ===
# CATALOG_FEED_PATH=data/amazon_jeans_shop.json
# TXTAI_INDEX_PATH=artifacts/txtai-index
# CATALOG_METADATA_PATH=artifacts/catalog-metadata.json
